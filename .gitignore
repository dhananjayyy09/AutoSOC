# AutoSOC — .gitignore

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
secrets/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
pip-wheel-metadata/
*.whl

# ─── Node.js / Frontend ──────────────────────────────────────────────────────
node_modules/
.next/
.nuxt/
dist/
.cache/
*.log

# ─── Data — Raw datasets (never commit large PCAP/CSV files) ─────────────────
data/raw/
data/processed/
data/cache/
*.pcap
*.pcapng
*.cap

# ─── IDE & OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Docker ──────────────────────────────────────────────────────────────────
.docker/

# ─── Compiled / Build artifacts ──────────────────────────────────────────────
*.o
*.so
*.dylib
