APP_ENV=development
DEBUG=false

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Database configuration
DATABASE_URL=postgresql://autosoc:autosoc_pass@localhost:5432/autosoc_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autosoc
POSTGRES_PASSWORD=autosoc_pass
POSTGRES_DB=autosoc_db

# Redis configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant configuration
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKERS=localhost:9092

# LLM Providers (Add keys as needed)
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Threat Intelligence Providers (Day 10 - disabled by default; offline deterministic mode)
TI_ENABLED=false
TI_PROVIDERS=
TI_TIMEOUT_SECONDS=3.0
TI_CACHE_TTL_SECONDS=300
TI_MAX_OBSERVABLES_PER_EVENT=10
TI_USE_REDIS_CACHE=true
TI_VIRUSTOTAL_API_KEY=
TI_ABUSEIPDB_API_KEY=
TI_OTX_API_KEY=
TI_GENERIC_API_KEY=
TI_GENERIC_BASE_URL=

# Security
JWT_SECRET=super_secret_key_change_in_production
